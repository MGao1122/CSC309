generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = "file:./dev.db"
}

model User {
    id        Int        @id @default(autoincrement())
    username  String     @unique
    email     String     @unique
    password  String // Hashed password
    role      String     @default("user") // user, admin
    firstName String
    lastName  String
    avatar    Bytes?
    phone     String?
    createdAt DateTime   @default(now())
    updatedAt DateTime   @updatedAt
    blogPosts BlogPost[]
    upBlog    BlogPost[] @relation("BlogPostUpUser")
    downBlog  BlogPost[] @relation("BlogPostDownUser")
    comments  Comment[]
    upVotes   Comment[]  @relation("CommentUpUser")
    downVotes Comment[]  @relation("CommentDownUser")
    template  Template[]
    report    Report[]
}

model Template {
    id             Int        @id @default(autoincrement())
    title          String
    description    String?
    visibility     Boolean    @default(true)
    tags           Tag[]      @relation("TemplateTags") // Many-to-many relationship
    parentId       Int?
    parentTemplate Template?  @relation("TemplateToParent", fields: [parentId], references: [id])
    childTemplates Template[] @relation("TemplateToParent")
    content        String
    language       String
    blogPosts      BlogPost[] @relation("BlogPostTemplates")
    authorId       Int
    author         User       @relation(fields: [authorId], references: [id])
    createdAt      DateTime   @default(now())
    updatedAt      DateTime   @updatedAt
    reportCount    Int        @default(0)
    report         Report[]
}

model Tag {
    id        Int        @id @default(autoincrement())
    name      String     @unique
    templates Template[] @relation("TemplateTags")
    blogPosts BlogPost[] @relation("BlogPostTags")
}

model BlogPost {
    id          Int        @id @default(autoincrement())
    title       String
    description String
    rating      Int        @default(0)
    upUser      User[]     @relation("BlogPostUpUser")
    downUser    User[]     @relation("BlogPostDownUser")
    visibility  Boolean    @default(true)
    tags        Tag[]      @relation("BlogPostTags") // Many-to-many relationship
    templates   Template[] @relation("BlogPostTemplates")
    authorId    Int
    author      User       @relation(fields: [authorId], references: [id])
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt
    comments    Comment[]
    reportCount Int        @default(0)
    report      Report[]
}

model Comment {
    id          Int       @id @default(autoincrement())
    content     String
    rating      Int       @default(0)
    upUser      User[]    @relation("CommentUpUser")
    downUser    User[]    @relation("CommentDownUser")
    visibility  Boolean   @default(true)
    authorId    Int
    author      User      @relation(fields: [authorId], references: [id])
    blogPostId  Int?
    blogPost    BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    parentId    Int?
    parent      Comment?  @relation("CommentToParent", fields: [parentId], references: [id], onDelete: Cascade)
    children    Comment[] @relation("CommentToParent")
    reportCount Int       @default(0)
    report      Report[]
}

model Report {
    id         Int       @id @default(autoincrement())
    content    String
    authorId   Int
    author     User      @relation(fields: [authorId], references: [id])
    blogPostId Int?
    blogPost   BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
    commentId  Int?
    comment    Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)
    templateId Int?
    template   Template? @relation(fields: [templateId], references: [id], onDelete: Cascade)
    createdAt  DateTime  @default(now())
}
